# تنظیمات سرور و نشست امنیتی
PORT=3000
NODE_ENV=production
SESSION_SECRET="CHANGE_THIS_TO_A_STRONG_64_CHAR_RANDOM_SECRET_KEY"

# تنظیمات اتصال به پایگاه داده MySQL / MariaDB (مناسب cPanel و سرور اختصاصی)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="cpanel_username_mgammon"
DB_PASSWORD="YOUR_STRONG_MYSQL_PASSWORD"
DB_NAME="cpanel_username_mgammon_duo"
DB_CONNECTION_LIMIT="10"

# تنظیمات حساب‌های اولیه (در اولین راه‌اندازی جدول users مقداردهی می‌شود)
INITIAL_MANAGER_USERNAME="manager"
INITIAL_MANAGER_PASSWORD="CHANGE_ME_MANAGER_PASSWORD"
INITIAL_WORKER_USERNAME="worker"
INITIAL_WORKER_PASSWORD="CHANGE_ME_WORKER_PASSWORD"

# منطقه زمانی پیش‌فرض سامانه
APP_TIMEZONE="Asia/Tehran"
APP_URL="https://your-domain.ir"

