{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "start:prod": "NODE_ENV=production node app.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --packages=external --format=cjs --outfile=app.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "clean": "rm -rf dist app.cjs",
    "lint": "tsc --noEmit",
    "backup:create": "tsx scripts/backup-cli.ts create",
    "backup:list": "tsx scripts/backup-cli.ts list",
    "backup:verify": "tsx scripts/backup-cli.ts verify",
    "backup:restore": "tsx scripts/backup-cli.ts restore"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jalaali-js": "^2.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
